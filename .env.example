# PostgreSQL. Con Neon, `neon env pull` completa ambas:
# DATABASE_URL = conexión pooled (host con -pooler), la usa la app.
# DATABASE_URL_UNPOOLED = conexión directa, la usan las migraciones.
# En local sin pooler, poné la misma URL en las dos.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/turnos"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/turnos"
# Secreto para firmar las cookies de sesión. Generalo con: openssl rand -base64 32
AUTH_SECRET=""
# Zona horaria del negocio (IANA)
BUSINESS_TIMEZONE="America/Argentina/Buenos_Aires"
# Base separada para los tests de integración (se borra en cada test)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/turnos_test"
